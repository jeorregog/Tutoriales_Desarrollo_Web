<%- contentFor('content') %>
<section class="max-w-6xl mx-auto">
<div class="mb-8 text-center">
<h2 class="text-3xl font-bold text-gray-800">Get in touch</h2>
<p class="mt-2 text-gray-600">Send us a message and we will be happy to help you.</p>
</div>
<div class="grid gap-6 lg:grid-cols-3">
<div class="rounded-xl bg-white p-6 shadow-sm lg:col-span-1">
<h3 class="text-xl font-semibold text-gray-800">Contact information</h3>
<div class="mt-6 space-y-5 text-gray-600">
<div class="flex items-start">
<i class="fas fa-envelope mt-1 mr-3 text-blue-500"></i>
<div>
<p class="font-medium text-gray-800">Email</p>
<p>support@libraryapp.com</p>
</div>
</div>
<div class="flex items-start">
<i class="fas fa-phone mt-1 mr-3 text-blue-500"></i>
<div>
<p class="font-medium text-gray-800">Phone</p>
<p>+57 300 000 0000</p>
</div>
</div>
<div class="flex items-start">
<i class="fas fa-location-dot mt-1 mr-3 text-blue-500"></i>
<div>
<p class="font-medium text-gray-800">Office</p>
<p>Bogotá, Colombia</p>
</div>
</div>
</div>
</div>
<form class="rounded-xl bg-white p-6 shadow-sm lg:col-span-2">
<div class="grid gap-5 md:grid-cols-2">
<div>
<label for="name" class="mb-2 block text-sm font-medium text-gray-700">Name</label>
<input id="name" name="name" type="text" class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200" placeholder="Your name">
</div>
<div>
<label for="email" class="mb-2 block text-sm font-medium text-gray-700">Email</label>
<input id="email" name="email" type="email" class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200" placeholder="you@example.com">
</div>
</div>
<div class="mt-5">
<label for="message" class="mb-2 block text-sm font-medium text-gray-700">Message</label>
<textarea id="message" name="message" rows="6" class="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200" placeholder="Write your message here"></textarea>
</div>
<button type="submit" class="mt-5 inline-flex items-center rounded-lg bg-blue-600 px-5 py-3 font-medium text-white transition hover:bg-blue-700">
<i class="fas fa-paper-plane mr-2"></i>
Send message
</button>
</form>
</div>
</section>
